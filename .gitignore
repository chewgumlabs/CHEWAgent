# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Build cache + module cache
/bin/
/dist/

# Editor cruft
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# CHEW runtime files (don't ship into the repo)
.chew/
brain.log
# The brain itself — Bonsai GGUF + per-user logs/config — lives in <repo>/brain/.
# Users download it via the install wizard. Never commit.
/brain/

# Local development overrides
*.local.json
